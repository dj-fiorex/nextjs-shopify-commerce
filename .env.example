COMPANY_NAME="CrazySociety"
SITE_NAME="CrazySociety"
SHOPIFY_REVALIDATION_SECRET=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
# Admin API access, used by `pnpm seed` and — at runtime — by the newsletter
# signup, which writes a customer with email-marketing consent. Either set a
# shpat_ token here, or the app credentials below.
SHOPIFY_ADMIN_ACCESS_TOKEN=""
SHOPIFY_STORE_DOMAIN="[your-shopify-store-subdomain].myshopify.com"
# Created by an app on shopify; the seed and the newsletter signup exchange
# these for a 24h admin token. The app needs the scopes listed in
# scripts/seed-shopify.mjs, including read_customers + write_customers for the
# newsletter.
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
